    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
				<configuration>
	                
					<additionalOptions>
						<additionalOption>-Xdoclint:none</additionalOption>
					</additionalOptions>
					<failOnError>false</failOnError>
					<stylesheetfile>site-resources/styles-new.css</stylesheetfile>
					<top>
						<![CDATA[<h2><a href='https://chenile.org'>Chenile Framework Javadocs</a></h2>]]>
					</top>
					<bottom>
						<![CDATA[Generated from Source. <a href="https://chenile.org">Chenile<a>]]>
					</bottom>
					<includeDependencySources>true</includeDependencySources>

					<links>
						<link>
							https://docs.spring.io/spring-framework/docs/current/javadoc-api/
						</link>
						<link>
							https://jakarta.ee/specifications/platform/9/apidocs/
						</link>
						<link>
							https://javadoc.io/doc/com.fasterxml.jackson.core/jackson-databind/2.3.1/
						</link>
						<link>
							https://javadoc.io/doc/org.apache.maven/maven-core/latest/
						</link>
					</links>
					<show>private</show>
					<groups>
						<group>
							<title>Core Packages</title>
							<packages>
								org.chenile.base*:org.chenile.core*:org.chenile.http*:org.chenile.proxy*:org.chenile.configuration.core:org.chenile.configuration.proxy:org.chenile.configuration.http*
							</packages>
						</group>
						<group>
							<title>Persistence</title>
							<packages>org.chenile.jpa*:org.chenile.configuration.jpautils*:org.chenile.configuration.multids*</packages>
						</group>
						<group>
							<title>Messaging</title>
							<packages>
								org.chenile.mqtt*:org.chenile.cloudedgeswitch*:org.chenile.pubsub.azure*:org.chenile.pubsub.jvm*:org.chenile.configuration.mqtt:org.chenile.configuration.cloudedgeswitch
							</packages>
						</group>
						<group>
							<title>STM/OWIZ/Workflow</title>
							<packages>
								org.chenile.owiz*:org.chenile.stm*:org.chenile.ognl:org.chenile.workflow*:org.chenile.configuration.workflow*:org.chenile.configuration.stm
							</packages>
						</group>
						<group>
							<title>Testing</title>
							<packages>
								org.chenile.cucumber*:org.chenile.testutils*:org.chenile.security.test
							</packages>
						</group>
						<group>
							<title>Security</title>
							<packages>org.chenile.security*:org.chenile.configuration.security</packages>
						</group>
						<group>
							<title>Query</title>
							<packages>org.chenile.query*:org.chenile.configuration.controller:org.chenile.configuration.query.*
							</packages>
						</group>
						<group>
							<title>Trigger and Crontab</title>
							<packages>org.chenile.trigger*:org.chenile.configuration.trigger*:org.chenile.configuration.crontab*</packages>
						</group>
						<group>
							<title>Process Management</title>
							<packages>org.chenile.orchestrator*:org.chenile.configuration.process
							</packages>
						</group>
						<group>
							<title>Pub Sub</title>
							<packages>org.chenile.pubsub*:org.chenile.configuration.pubsub
							</packages>
						</group>
						<group>
							<title>Service Registry</title>
							<packages>org.chenile.service.registry*
							</packages>
						</group>
						<group>
							<title>Administration and MCP</title>
							<packages>org.chenile.mcp*:org.chenile.configuration.mcp:org.chenile.configuration.admin:org.chenile.configuration.workflow.info*
							</packages>
						</group>
						<group>
							<title>Utilities and Runtime</title>
							<packages>org.chenile.utils*:org.chenile.cache*:org.chenile.filewatch*:org.chenile.scheduler*:org.chenile.configuration.utils:org.chenile.configuration.filewatch:org.chenile.configuration.scheduler:org.chenile.configuration.cache</packages>
						</group>
						<group>
							<title>Configuration</title>
							<packages>org.chenile.cconfig*:org.chenile.configuration.*
							</packages>
						</group>
						<group>
							<title>Developer Tools</title>
							<packages>org.chenile.config.plugin:org.chenile</packages>
						</group>
						<group>
							<title>Others</title>
							<packages>org.chenile.*</packages>
						</group>
					</groups>
				</configuration>
            </plugin>
        </plugins>
